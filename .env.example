# Copy to .env and fill in — or run `neon link` which auto-populates these.
# Set the same two DATABASE_* vars in the Vercel project settings
# (or use the Neon–Vercel integration, which injects them automatically).

# Pooled Postgres URL (app runtime — host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct/unpooled Postgres URL (prisma db push / migrations — host WITHOUT "-pooler").
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Set by `neon link` (informational; not required by the app).
# NEON_BRANCH="production"

# Secret for the daily auto-reseed cron. Generate a long random string and set the
# SAME value in the Vercel project env vars — Vercel sends it as a Bearer token to /api/reseed.
CRON_SECRET="change-me-to-a-long-random-string"

# ── WhatsApp (Meta Cloud API) ──────────────────────────────────────────
# Leave MESSAGING_PROVIDER unset for the demo (mock sends). Set to "meta" to send
# real WhatsApp template messages. See WHATSAPP.md for full setup + the templates
# you must create in Meta Business Manager.
# MESSAGING_PROVIDER="meta"
# WHATSAPP_PHONE_NUMBER_ID="1234567890"
# WHATSAPP_TOKEN="EAAG...your-permanent-access-token..."
# WHATSAPP_API_VERSION="v21.0"        # optional
# WHATSAPP_TEMPLATE_LANG="en"          # optional; must match your template language
# Optional template-name overrides (defaults shown):
# WA_TPL_CONFIRM="appt_confirmation"
# WA_TPL_REMINDER_24H="appt_reminder_24h"
# WA_TPL_REMINDER_2H="appt_reminder_2h"
# WA_TPL_REPORT_SHARE="report_ready"
# WA_TPL_RECALL="followup_recall"
# WA_TPL_DUES="payment_reminder"
# Webhook (delivery/read status): set WHATSAPP_VERIFY_TOKEN to any random string and
# use the same value in Meta's webhook config; WHATSAPP_APP_SECRET (from your Meta app)
# enables signature verification of incoming callbacks. Callback URL: <site>/api/whatsapp/webhook
# WHATSAPP_VERIFY_TOKEN="a-random-string-you-choose"
# WHATSAPP_APP_SECRET="your-meta-app-secret"
