# Copy to .env and fill in — or run `neon link` which auto-populates these.
# Set the same two DATABASE_* vars in the Vercel project settings
# (or use the Neon–Vercel integration, which injects them automatically).

# Pooled Postgres URL (app runtime — host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct/unpooled Postgres URL (prisma db push / migrations — host WITHOUT "-pooler").
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Set by `neon link` (informational; not required by the app).
# NEON_BRANCH="production"

# Optional: set to "bsp" once a WhatsApp BSP is implemented in src/lib/messaging.ts
# MESSAGING_PROVIDER="bsp"
