# Copy to .env and fill in. These are the env vars the app needs.
# Also set DATABASE_URL and DIRECT_URL in the Vercel project settings.

# Pooled Postgres URL (app runtime). From Neon: the "-pooler" host.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/orthocare?sslmode=require"

# Direct Postgres URL (prisma db push / migrations). From Neon: host without "-pooler".
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/orthocare?sslmode=require"

# Optional: set to "bsp" once a WhatsApp BSP is implemented in src/lib/messaging.ts
# MESSAGING_PROVIDER="bsp"
